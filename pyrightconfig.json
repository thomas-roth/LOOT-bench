{
  "typeCheckingMode": "basic", // "off", "basic", "strict"
  "reportOptionalMemberAccess": "none", // don't flag attempts to access attribute/method of variable that could be None
  "reportAttributeAccessIssue": "none", // mujoco ships no type stubs (MjSpec, mjt* enums, ...); stubs would have to be generated for every new mujoco release
  "pythonVersion": "3.10",
  "include": ["loot_bench", "tests"],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "**/build",
    "**/dist",
    "**/node_modules",
    "**/.*",
  ],
}
