# default to LF
* text=auto eol=lf

# use CRLF for windows-specific files
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# binary files
*.png binary
*.jpg binary
*.pdf binary
*.npz binary
*.parquet binary
graphify-out/graph.json merge=graphify
