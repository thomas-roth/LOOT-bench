<mujoco model="trlc_dk1">
  <!-- TRLC-DK1 follower arm, converted from the official URDF:
       https://github.com/robot-learning-co/trlc-dk1 (Apache-2.0).
       Joint frames, limits and inertials mirror TRLC-DK1-Follower.urdf.
       Motors: joints 1-3 DAMIAO DM4340, joints 4-6 DM4310,
       gripper DM4310 via 8.75 mm rack-and-pinion (114 N, 0.183 m/s). -->
  <compiler angle="radian" meshdir="assets" />

  <default>
    <default class="dk1">
      <site group="5" size="0.005" rgba="0 1 0 1" />
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" />
      </default>
      <default class="collision">
        <geom type="mesh" group="3" />
        <!-- No official pad dimensions exist in the URDF (its finger links
             only have one full-mesh collision); size/pos below were
             hand-measured against the converted finger mesh to approximate
             just the fingertip contact patch. -->
        <default class="pad_collision">
          <geom type="box" rgba="1 0 0 1" group="4" />
        </default>
      </default>
      <default class="finger">
        <joint type="slide" range="-0.045 0.001" />
      </default>
    </default>
  </default>

  <asset>
    <material name="grey_08" rgba="0.0849 0.0849 0.0849 1" />
    <material name="grey_15" rgba="0.15 0.15 0.15 1" />
    <material name="grey_18" rgba="0.1809 0.1809 0.1809 1" />
    <material name="grey_25" rgba="0.2503 0.2503 0.2503 1" />
    <material name="green" rgba="0.3251 0.5342 0.2778 1" />
    <material name="grey_45" rgba="0.4523 0.4523 0.4523 1" />
    <material name="grey_62" rgba="0.6286 0.6286 0.6286 1" />
    <material name="grey_96" rgba="0.9611 0.9611 0.9647 1" />
    <material name="beige" rgba="1.0 0.9482 0.9102 1" />

    <mesh file="base_link_0.obj" />
    <mesh file="base_link_1.obj" />
    <mesh file="base_link_col.stl" />

    <mesh file="link1-2_0.obj" />
    <mesh file="link1-2_1.obj" />
    <mesh file="link1-2_2.obj" />
    <mesh file="link1-2_col.stl" />

    <mesh file="link2-3_0.obj" />
    <mesh file="link2-3_1.obj" />
    <mesh file="link2-3_2.obj" />
    <mesh file="link2-3_3.obj" />
    <mesh file="link2-3_col.stl" />

    <mesh file="link3-4_0.obj" />
    <mesh file="link3-4_1.obj" />
    <mesh file="link3-4_2.obj" />
    <mesh file="link3-4_3.obj" />
    <mesh file="link3-4_col.stl" />

    <mesh file="link4-5_0.obj" />
    <mesh file="link4-5_1.obj" />
    <mesh file="link4-5_2.obj" />
    <mesh file="link4-5_3.obj" />
    <mesh file="link4-5_col.stl" />

    <mesh file="link5-6_0.obj" />
    <mesh file="link5-6_1.obj" />
    <mesh file="link5-6_2.obj" />
    <mesh file="link5-6_3.obj" />
    <mesh file="link5-6_col.stl" />

    <mesh file="link6-7_0.obj" />
    <mesh file="link6-7_1.obj" />
    <mesh file="link6-7_2.obj" />
    <mesh file="link6-7_3.obj" />
    <mesh file="link6-7_4.obj" />
    <mesh file="link6-7_col.stl" />

    <mesh file="finger_left_0.obj" />
    <mesh file="finger_left_1.obj" />
    <mesh file="finger_left_2.obj" />
    <mesh file="finger_left_3.obj" />
    <mesh file="finger_left_col.stl" />

    <mesh file="finger_right_0.obj" />
    <mesh file="finger_right_1.obj" />
    <mesh file="finger_right_2.obj" />
    <mesh file="finger_right_3.obj" />
    <mesh file="finger_right_col.stl" />
  </asset>

  <worldbody>
    <light
            name="spotlight"
            mode="targetbodycom"
            target="link6-7"
            pos="0 0 1.5"
        />
    <camera name="front_cam" pos="1.1 0 .5" xyaxes="0 1 0 -0.3 0 0.7" />
    <body name="base" childclass="dk1">
      <inertial
                pos="0 0 0.027324"
                mass="0.5111"
                diaginertia="0.00017 0.00017 0.00016"
            />
      <geom class="visual" mesh="base_link_0" material="grey_18" />
      <geom class="visual" mesh="base_link_1" material="grey_96" />
      <geom name="base_link_collision" class="collision" mesh="base_link_col" />
      <body name="link1-2" pos="0 0 0.0615">
        <inertial
                    pos="0.0054231 0 0.017086"
                    mass="0.5965"
                    fullinertia="0.00008 0.00003 0.00008 0 0.00001 0"
                />
        <joint
                    name="joint1"
                    axis="0 0 1"
                    range="-2.0943951023931953 2.0943951023931953"
                />
        <geom class="visual" mesh="link1-2_0" material="grey_25" />
        <geom class="visual" mesh="link1-2_1" material="grey_62" />
        <geom class="visual" mesh="link1-2_2" material="grey_96" />
        <geom name="link1-2_collision" class="collision" mesh="link1-2_col" />
        <body name="link2-3" pos="0.02 0 0.0385">
          <inertial
                        pos="-0.132 0 0"
                        mass="0.9084"
                        diaginertia="0.00051 0.01599 0.01605"
                    />
          <joint
                        name="joint2"
                        axis="0 1 0"
                        range="-0.08726646259971647 3.141592653589793"
                    />
          <geom class="visual" mesh="link2-3_0" material="grey_25" />
          <geom class="visual" mesh="link2-3_1" material="grey_45" />
          <geom class="visual" mesh="link2-3_2" material="grey_62" />
          <geom class="visual" mesh="link2-3_3" material="grey_96" />
          <geom name="link2-3_collision" class="collision" mesh="link2-3_col" />
          <body name="link3-4" pos="-0.264 0 0">
            <inertial
                            pos="0.18531 0.00068376 0.051638"
                            mass="0.7089"
                            fullinertia="0.00036 0.00423 0.00420 -0.00003 0.00039 0.00001"
                        />
            <joint
                            name="joint3"
                            axis="0 -1 0"
                            range="-0.08726646259971647 4.71238898038469"
                        />
            <geom class="visual" mesh="link3-4_0" material="grey_15" />
            <geom class="visual" mesh="link3-4_1" material="grey_25" />
            <geom class="visual" mesh="link3-4_2" material="grey_62" />
            <geom class="visual" mesh="link3-4_3" material="grey_96" />
            <geom
                            name="link3-4_collision"
                            class="collision"
                            mesh="link3-4_col"
                        />
            <body name="link4-5" pos="0.244004 0 0.059971">
              <inertial
                                pos="0.040231 0.0044807 0.035335"
                                mass="0.3995"
                                fullinertia="0.00019 0.00023 0.00014 -0.00002 -0.00009 0.00002"
                            />
              <joint
                                name="joint4"
                                axis="0 -1 0"
                                range="-1.95 1.5707963267948966"
                            />
              <geom class="visual" mesh="link4-5_0" material="grey_25" />
              <geom class="visual" mesh="link4-5_1" material="grey_45" />
              <geom class="visual" mesh="link4-5_2" material="grey_62" />
              <geom class="visual" mesh="link4-5_3" material="grey_96" />
              <geom
                                name="link4-5_collision"
                                class="collision"
                                mesh="link4-5_col"
                            />
              <body name="link5-6" pos="0.061868 0 0.0425">
                <inertial
                                    pos="0.003612 0 0"
                                    mass="0.4121"
                                    fullinertia="0.00083 0.00082 0.00026 0 0.00007 0"
                                />
                <joint
                                    name="joint5"
                                    axis="0 0 -1"
                                    range="-1.5707963267948966 1.5707963267948966"
                                />
                <geom class="visual" mesh="link5-6_0" material="grey_25" />
                <geom class="visual" mesh="link5-6_1" material="grey_45" />
                <geom class="visual" mesh="link5-6_2" material="grey_62" />
                <geom class="visual" mesh="link5-6_3" material="grey_96" />
                <geom
                                    name="link5-6_collision"
                                    class="collision"
                                    mesh="link5-6_col"
                                />
                <body name="link6-7" pos="0.032 0 -0.0425">
                  <inertial
                                        pos="0.041697 0.0000244 0.00014464"
                                        mass="0.5"
                                        diaginertia="0.00038 0.00028 0.00050"
                                    />
                  <joint
                                        name="joint6"
                                        axis="1 0 0"
                                        range="-2.0943951023931953 2.0943951023931953"
                                    />
                  <geom class="visual" mesh="link6-7_0" material="grey_08" />
                  <geom class="visual" mesh="link6-7_1" material="grey_25" />
                  <geom class="visual" mesh="link6-7_2" material="grey_45" />
                  <geom class="visual" mesh="link6-7_3" material="grey_62" />
                  <geom class="visual" mesh="link6-7_4" material="grey_96" />
                  <geom
                                        name="link6-7_collision"
                                        class="collision"
                                        mesh="link6-7_col"
                                    />
                  <!-- tool0 frame from the URDF: z points out of the flange
                       (along +x of link6-7), between the fingertips. -->
                  <site name="tool0" pos="0.158 0 0" xyaxes="0 -1 0 0 0 -1" />
                  <site
                                        name="grasp_site"
                                        pos="0.125 0 0"
                                        xyaxes="0 -1 0 0 0 -1"
                                    />
                  <body name="finger_left">
                    <inertial
                                            pos="0.08 0.04 0"
                                            mass="0.05"
                                            diaginertia="0.00002 0.00003 0.00003"
                                        />
                    <joint name="gripper_left" class="finger" axis="0 1 0" />
                    <geom
                                            class="visual"
                                            mesh="finger_left_0"
                                            material="grey_25"
                                        />
                    <geom
                                            class="visual"
                                            mesh="finger_left_1"
                                            material="green"
                                        />
                    <geom
                                            class="visual"
                                            mesh="finger_left_2"
                                            material="grey_62"
                                        />
                    <geom
                                            class="visual"
                                            mesh="finger_left_3"
                                            material="beige"
                                        />
                    <geom
                                            name="finger_left_collision"
                                            class="collision"
                                            mesh="finger_left_col"
                                        />
                    <geom
                                            name="finger_left_pad_collision"
                                            class="pad_collision"
                                            size="0.035 0.0015 0.022"
                                            pos="0.119 0.0395 0"
                                        />
                  </body>
                  <body name="finger_right">
                    <inertial
                                            pos="0.08 -0.04 0"
                                            mass="0.05"
                                            diaginertia="0.00002 0.00003 0.00003"
                                        />
                    <joint name="gripper_right" class="finger" axis="0 -1 0" />
                    <geom
                                            class="visual"
                                            mesh="finger_right_0"
                                            material="grey_25"
                                        />
                    <geom
                                            class="visual"
                                            mesh="finger_right_1"
                                            material="green"
                                        />
                    <geom
                                            class="visual"
                                            mesh="finger_right_2"
                                            material="grey_62"
                                        />
                    <geom
                                            class="visual"
                                            mesh="finger_right_3"
                                            material="beige"
                                        />
                    <geom
                                            name="finger_right_collision"
                                            class="collision"
                                            mesh="finger_right_col"
                                        />
                    <geom
                                            name="finger_right_pad_collision"
                                            class="pad_collision"
                                            size="0.035 0.0015 0.022"
                                            pos="0.119 -0.0395 0"
                                        />
                  </body>
                  <!-- Wrist camera mount, tilted down 15 deg. URDF camera frame
                       has +x as the optical axis and +z up; MuJoCo cameras look
                       along -z with +y up, hence the xyaxes remap. -->
                  <body
                                        name="camera_mount"
                                        pos="0.0471 0 0.063314"
                                        euler="0 0.2618 0"
                                    >
                    <camera
                                            name="wrist_camera"
                                            pos="0 0 0"
                                            xyaxes="0 -1 0 0 0 1"
                                            resolution="1280 720"
                                            fovy="58"
                                        />
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- Both fingers are driven by one motor through the rack-and-pinion. -->
    <joint joint1="gripper_left" joint2="gripper_right" polycoef="0 1 0 0 0" />
  </equality>
</mujoco>
