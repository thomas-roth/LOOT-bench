<mujoco model="trlc_dk1 scene">
  <!-- Standalone visualization scene, e.g. `python -m mujoco.viewer` drag-and-drop. -->
  <include file="dk1.xml"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.9" rgb2="0.9 0.9 0.95"
      width="64" height="64"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.7 0.7 0.7"
      rgb2="0.85 0.85 0.85" width="64" height="64"/>
    <material name="grid" texture="grid" texrepeat="4 4"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>
  </worldbody>
</mujoco>
