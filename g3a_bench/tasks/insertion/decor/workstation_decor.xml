<!--
  Decorative "machine-shop workstation" dressing shared by every insertion
  variant. Loaded as a single fixed-base entity (one root body -> mjlab mocap).

  Everything here is VISUAL ONLY: every geom sets contype/conaffinity = 0 (via
  the `decor` default class) so the dressing can never collide with the robot,
  the board or the pegs and therefore cannot affect the RL task. Geom poses are
  expressed directly in env-local coordinates (robot base at origin, board near
  x = 0.34), so the body itself stays at the env origin.

  Meshes are generated by `make_decor_meshes.py` into `meshes/`.
-->
<mujoco model="insertion_decor">
  <compiler meshdir="meshes" angle="radian"/>

  <default>
    <default class="decor">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <asset>
    <mesh name="decor_tool_tray" file="tool_tray.stl"/>

    <material name="decor_mat" rgba="0.20 0.23 0.27 1"/>
    <material name="decor_steel" rgba="0.55 0.58 0.62 1"/>
    <material name="decor_panel" rgba="0.30 0.45 0.55 1"/>
  </asset>

  <worldbody>
    <body name="decor">
      <!-- Dark workbench mat grounding the workspace (just above the floor). -->
      <geom class="decor" type="box" pos="0.34 0.0 0.001"
            size="0.26 0.34 0.001" material="decor_mat"/>

      <!-- Pegboard backdrop panel behind the board. -->
      <geom class="decor" type="box" pos="0.54 0.0 0.16"
            size="0.006 0.34 0.16" material="decor_panel"/>

      <!-- Parts tray in front of the board; the pegs are spawned into it each
           reset (pos must match insertion.assets.TRAY_POS). -->
      <geom class="decor" type="mesh" mesh="decor_tool_tray"
            pos="0.16 0.0 0.0" material="decor_steel"/>
    </body>
  </worldbody>
</mujoco>
