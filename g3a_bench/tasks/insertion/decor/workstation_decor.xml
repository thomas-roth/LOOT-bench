<!--
  Decorative "machine-shop workstation" dressing shared by every insertion
  variant. Loaded as a single fixed-base entity (one root body -> mjlab mocap).

  Most geoms are VISUAL ONLY: they set contype/conaffinity = 0 (via the `decor`
  default class) so they can never collide with the robot, the board or the
  pegs. The one exception is the parts tray ("Werkbox") in the `werkbox` child
  body: it has real collision geometry so the pegs rest inside it and a robot
  end-effector crashing into it can be detected (ee_werkbox_collision). Geom
  poses are expressed directly in env-local coordinates (robot base at origin,
  board near x = 0.34), so the bodies themselves stay at the env origin.

  Meshes are generated by `make_decor_meshes.py` into `meshes/`.
-->
<mujoco model="insertion_decor">
  <compiler meshdir="meshes" angle="radian"/>

  <default>
    <default class="decor">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="werkbox">
      <!-- Collidable parts tray: keep default contype/conaffinity (=1). -->
      <geom group="2"/>
    </default>
  </default>

  <asset>
    <material name="decor_mat" rgba="0.20 0.23 0.27 1"/>
    <material name="decor_steel" rgba="0.55 0.58 0.62 1"/>
    <material name="decor_panel" rgba="0.30 0.45 0.55 1"/>
  </asset>

  <worldbody>
    <body name="decor">
      <!-- Dark workbench mat grounding the workspace (just above the floor). -->
      <geom class="decor" type="box" pos="0.34 0.0 0.001"
            size="0.26 0.34 0.001" material="decor_mat"/>

      <!-- Parts tray ("Werkbox") in front of the board; the pegs are spawned
           into it each reset. Built from collidable boxes (floor + 4 rim walls)
           so pegs rest inside and ee_werkbox_collision can fire. Footprint must
           match insertion.assets.TRAY_* and make_decor_meshes.TRAY_*. -->
      <body name="werkbox">
        <geom class="werkbox" type="box" pos="0.16 0.0 0.003"
              size="0.080 0.155 0.003" material="decor_steel"/>
        <geom class="werkbox" type="box" pos="0.236 0.0 0.017"
              size="0.004 0.155 0.017" material="decor_steel"/>
        <geom class="werkbox" type="box" pos="0.084 0.0 0.017"
              size="0.004 0.155 0.017" material="decor_steel"/>
        <geom class="werkbox" type="box" pos="0.16 0.151 0.017"
              size="0.080 0.004 0.017" material="decor_steel"/>
        <geom class="werkbox" type="box" pos="0.16 -0.151 0.017"
              size="0.080 0.004 0.017" material="decor_steel"/>
      </body>
    </body>
  </worldbody>
</mujoco>
